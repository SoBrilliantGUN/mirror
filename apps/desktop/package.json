{
  "name": "@mirror/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "build:renderer": "npm run build -w @mirror/client && node scripts/copy-renderer.mjs",
    "prepare:pgvector": "node scripts/prepare-pgvector.mjs",
    "dev": "node build.mjs && npm run build:renderer && electron .",
    "start": "electron .",
    "dist": "node scripts/prepare-pgvector.mjs && node build.mjs && npm run build:renderer && electron-builder --win zip"
  },
  "dependencies": {
    "embedded-postgres": "16.15.0-beta.19",
    "langfuse": "^3.39.2",
    "opusscript": "^0.1.1",
    "pg": "^8.23.1",
    "pitchfinder": "^2.3.2",
    "pinyin-pro": "^3.29.5",
    "werift": "^0.27.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.mirror.coach",
    "productName": "mirror",
    "asar": false,
    "files": [
      "dist/**",
      "renderer/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["zip"]
    }
  }
}
