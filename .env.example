# 复制为 .env 并填入真 key（.env 已 gitignore，绝不进 git）
# 你的名字（可选；填了能避免语音识别把名字听成同音字，桌面版在设置里填）
USER_NAME=

# L3 大脑（DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SCORE_MODEL=deepseek-chat
GENERATE_MODEL=deepseek-chat

# L4 安全红线（阿里云百炼小模型，复用 DASHSCOPE_API_KEY；OpenAI 兼容 /chat/completions 端点）
# 注意：DASHSCOPE_API_KEY 是千问中转站 key 时，端点必须指到中转站的 compatible-mode，
# 否则会 429（key 与端点不匹配）。官方百炼才用 https://dashscope.aliyuncs.com/compatible-mode/v1。
SAFETY_MODEL=qwen-flash
SAFETY_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# 长期记忆 embedding（阿里云百炼 OpenAI 兼容端点；没单独 key 就复用 DASHSCOPE_API_KEY）
# EMBEDDING_BASE_URL 示例：https://dashscope.aliyuncs.com/compatible-mode/v1 或 https://maas.qianwenaiapi.com/v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 上下文窗口（参考 kima 六层窗口，压缩只打 L5 历史）
CONTEXT_MAX_TOKENS=64000   # deepseek-chat 官方窗口
MEMORY_RECALL_TOP_K=5

# L2 语音（阿里云百炼 · CosyVoice + Paraformer）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://maas.qianwenaiapi.com
# 实时流式 WebSocket 端点（需 WorkspaceId 时改成 wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference）
DASHSCOPE_WS_URL=wss://maas.qianwenaiapi.com/api-ws/v1/inference
# TTS 兜底端点：主端点（中转站）网络不可达/限流耗尽时自动切换。
# 注意官方 key 与中转 key 不通用——这里要用阿里云百炼官方 key（sk-...），不是中转站的 sk-ws-...
# 不填 DASHSCOPE_OFFICIAL_API_KEY 则兜底不启用（只用主端点 + 重试）。
DASHSCOPE_WS_FALLBACK_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_OFFICIAL_API_KEY=
COSYVOICE_MODEL=cosyvoice-v3.5-plus
# 音色 ID（声音设计生成）：每位陪伴者一个，2 男 2 女不能共用一张嘴
# 程书衡（男）
COSYVOICE_VOICE=
# 沈知遥（女）
COSYVOICE_VOICE_SZY=
# 沈砚秋（男）
COSYVOICE_VOICE_SYQ=
# 苏明悦（女）
COSYVOICE_VOICE_SMY=
# —— 英文音色（练英语用，language_hints:['en'] 建模；未填则英文回落中文音色带口音）——
# 程书衡（男 · EN）
COSYVOICE_VOICE_EN=
# 沈知遥（女 · EN）
COSYVOICE_VOICE_SZY_EN=
# 沈砚秋（男 · EN）
COSYVOICE_VOICE_SYQ_EN=
# 苏明悦（女 · EN）
COSYVOICE_VOICE_SMY_EN=
PARAFORMER_MODEL=paraformer-realtime-v2

# L2 非言语发声检测（哭/笑）—— 阿里云智能语音交互 NLS「声音事件检测」（云端，零本地模型）
# 总开关：false 时整体关闭（如 token 过期一直 403 时临时关掉），默认开启
NLS_ENABLED=
# 两种配法（二选一，且都要配 NLS_APPKEY）：
#   A. 已拿到 token → 只填 NLS_ACCESS_TOKEN
#   B. 用 AccessKey 自动换 token → 填 NLS_ACCESS_KEY_ID + NLS_ACCESS_KEY_SECRET
NLS_APPKEY=
NLS_ACCESS_TOKEN=
NLS_ACCESS_KEY_ID=
NLS_ACCESS_KEY_SECRET=

# 联网搜索（博查 Web Search）：用户问陌生词 / 被事实纠正时真查；没 key 则搜索降级关闭
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1

# 可观测（LangFuse 自托管，见 infra/langfuse；key 由 headless init 预置在 infra/langfuse/.env 的 LANGFUSE_INIT_*）
# - 离线评测脚本（npm run ...，宿主直接跑）→ 用这里的 localhost:3002
# - 运行时通话埋点：server 容器内经 docker-compose 覆盖成 host.docker.internal:3002（见 docker-compose.yml）
# 两者都配 PUBLIC/SECRET；没配则运行时埋点整体 no-op，不影响通话
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=http://localhost:3002

# 数据库（app 专用 Postgres，见 infra/postgres；密码在 infra/postgres/.env）
# POSTGRES_PASSWORD 供 docker-compose 的 postgres 服务使用（与 infra/postgres/.env 一致）
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://mirror:CHANGE_ME@localhost:5432/mirror

# 实时语音 ICE（Docker 下浏览器直达容器）：本地填 127.0.0.1，远程填公网/LAN IP
ICE_HOST_ADDRESS=127.0.0.1
ICE_PORT_RANGE=50000-50100
